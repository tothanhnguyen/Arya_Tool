# Copy file nay thanh .env roi dien gia tri. KHONG commit .env.

# Ten ung dung (thuong khong can doi)
LAPLACE_APP_NAME=arya-tool

# Database URL. De chay Supabase, dan Direct/Session Pooler URL vao day.
# Arya_Tool tu chuyen postgresql:// thanh driver postgresql+psycopg://.
LAPLACE_DB_URL=sqlite:///./arya-tool.db
LAPLACE_DB_POOL_SIZE=5
LAPLACE_DB_MAX_OVERFLOW=5
LAPLACE_DB_CONNECT_TIMEOUT_S=10
LAPLACE_DB_SSL_MODE=require

# Supabase — de trong cho den khi ban tao project va dien key server-side.
# Publishable/anon key chi dung de validate user session. SECRET_KEY chi dung
# server-side cho Storage, khong dua vao HTML/JavaScript/Git.
LAPLACE_SUPABASE_URL=
LAPLACE_SUPABASE_SECRET_KEY=
LAPLACE_SUPABASE_PUBLISHABLE_KEY=
LAPLACE_SUPABASE_ANON_KEY=
LAPLACE_SUPABASE_AUTH_ENABLED=false
LAPLACE_SUPABASE_AUTH_COOKIE_NAME=arya_supabase_access_token
LAPLACE_SUPABASE_AUTH_TIMEOUT_S=5
LAPLACE_SUPABASE_MEDIA_BUCKET=arya-media
LAPLACE_SUPABASE_ARTIFACT_BUCKET=arya-artifacts
LAPLACE_SUPABASE_ARTIFACT_MAX_BYTES=52428800
LAPLACE_SUPABASE_SIGNED_URL_TTL_S=300

# Social publishing: mock la mac dinh an toan. Browser publisher phai bat
# tuong minh va chi dung voi tai khoan/Page thu nghiem cua chinh ban.
LAPLACE_SOCIAL_PUBLISHER=mock
LAPLACE_SOCIAL_TIMEZONE=Asia/Ho_Chi_Minh
LAPLACE_SOCIAL_DAILY_POST_LIMIT=2
LAPLACE_SOCIAL_BROWSER_PUBLISHER=false
LAPLACE_SOCIAL_POLL_SECONDS=15
LAPLACE_SOCIAL_MEDIA_DIR=media
LAPLACE_SOCIAL_MEDIA_BACKEND=local
LAPLACE_SOCIAL_MEDIA_MAX_BYTES=52428800
LAPLACE_SOCIAL_CURRENCY=VND

# Copywriter rieng: tac vu viet content don gian dung OpenRouter Free.
LAPLACE_SOCIAL_CONTENT_PROVIDER=openrouter
LAPLACE_SOCIAL_CONTENT_MODEL=openrouter/free
LAPLACE_SOCIAL_CONTENT_MAX_RETRIES=1

# LLM provider (preset registry — xem laplace/llm/presets.py):
#   mock | gemini | openai | groq | openrouter | deepseek | xai | mistral | ollama
# Setup nhanh: python -m laplace.llm.setup (wizard dan key + validate + tu ghi file nay)
LAPLACE_LLM_PROVIDER=mock

# Override model chung cho MOI provider (bo trong = model mac dinh cua preset)
LAPLACE_LLM_MODEL=

# OpenAI API key (bat buoc khi LAPLACE_LLM_PROVIDER=openai)
LAPLACE_OPENAI_API_KEY=

# Model OpenAI dung cho agent
LAPLACE_OPENAI_MODEL=gpt-4o-mini

# Gemini (bat buoc khi LAPLACE_LLM_PROVIDER=gemini; dung endpoint tuong thich OpenAI)
LAPLACE_GEMINI_API_KEY=
LAPLACE_GEMINI_MODEL=gemini-3.1-flash-lite

# Key cac hang khac (chi dien hang minh dung; trang lay key xem README muc
# "Noi API key hang AI"). Ollama chay local, khong can key.
LAPLACE_GROQ_API_KEY=
LAPLACE_OPENROUTER_API_KEY=
LAPLACE_DEEPSEEK_API_KEY=
LAPLACE_XAI_API_KEY=
LAPLACE_MISTRAL_API_KEY=

# Token Telegram bot (lay tu @BotFather); bo trong thi khong chay bot
LAPLACE_TELEGRAM_BOT_TOKEN=

# Dashboard chi nghe localhost theo mac dinh.
LAPLACE_WEB_HOST=127.0.0.1
LAPLACE_WEB_PORT=8010

# API key bao ve REST API + trace viewer (header X-API-Key).
# Bo trong = mo, CHI dung khi dev local; deploy len server thi PHAI dat.
LAPLACE_API_KEY=

# Tavily API key cho tool web_search; bo trong thi tool chay che do stub
LAPLACE_SEARCH_API_KEY=

# Gioi han an toan cua agent loop
LAPLACE_MAX_STEPS=8            # so buoc toi da moi task
LAPLACE_TOOL_TIMEOUT_S=15      # timeout moi lan goi tool (giay)
LAPLACE_TASK_TIMEOUT_S=180     # timeout toan bo task (giay)
LAPLACE_TOOL_MAX_RETRIES=2     # so lan retry khi tool loi
